{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ndm:common-config-types",
    "$version": 1,
    "title": "NDM Common Config Types",
    "$defs": {
        "x-ndm-cfg-int": {
            "type": "integer"
        },
        "x-ndm-cfg-path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])/(?:[^/]+(?:/[^/]+)*/?)?$"
        },
        "x-ndm-cfg-bool": {
            "type": "boolean"
        },
        "x-ndm-cfg-str": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
        },
        "x-ndm-cfg-str-allow-empty": {
            "type": "string",
            "maxLength": 4096
        }
    }
}
