#
# White-list style gitignore file
#

# Ignore everything first.
*

# Allow list
!.gitignore
!README.md
!LICENSE
!Cargo.toml
!Cargo.lock
!requirements.txt
!deploy.py
!setup_vscode.sh

# Cargo defaults
!.cargo/
!.cargo/config.toml

# Editor build routing
!.vscode/
!.vscode/settings.json

# Project sources
!src/
!src/**

# Packaging files
!packaging/
!packaging/**

# Documentation
!docs/
!docs/**

# Tests
!tests/
!tests/**

# Scripts
!scripts/
!scripts/**

# Python bytecode generated by project-level venv test runs.  Keep these rules
# after the directory allowlist so nested caches stay ignored.
**/__pycache__/
*.py[cod]
